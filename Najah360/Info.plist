	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Najah360 needs Bluetooth to connect with nearby devices for emergency mesh networking.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Najah360 uses Bluetooth to create emergency communication networks.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_najahmesh._tcp</string>
		<string>_najahmesh._udp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Najah360 needs camera access to share photos during emergencies.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Najah360 needs local network access to discover and connect with nearby devices for emergency mesh networking.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Najah360 needs location access to maintain mesh network connections in background.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Najah360 needs location access to maintain emergency connections even when app is in background.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Najah360 needs location access to discover nearby devices via Bluetooth.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Najah360 needs microphone access for voice messages during emergencies.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Najah360 needs permission to save emergency photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Najah360 needs photo library access to share images during emergencies.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
